{
  "name": "dsh-chat-timeline-plus",
  "version": "0.2.0",
  "description": "DeepSeek 官网风格消息时间线（增强版 fork）：悬停问答预览、面板钉住常驻、重点标记、平滑跳转。fork of dsh-chat-timeline.",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "conversation",
    "navigation",
    "timeline",
    "bookmarks",
    "rewind",
    "hover-preview",
    "pin",
    "plus"
  ],
  "author": "NIU-001-LIU",
  "contributors": [
    "jjxjjjjiik-bot (dsh-chat-timeline upstream)",
    "NIU-001-LIU",
    "dwb-ajay",
    "YuYangOUC",
    "mill413",
    "RoyougiShiki"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NIU-001-LIU/dsh-chat-timeline-plus.git"
  },
  "homepage": "https://github.com/NIU-001-LIU/dsh-chat-timeline-plus#readme",
  "bugs": {
    "url": "https://github.com/NIU-001-LIU/dsh-chat-timeline-plus/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "assets",
    "install.ps1",
    "install.bat",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-session-projection": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^4.4.3"
  }
}
